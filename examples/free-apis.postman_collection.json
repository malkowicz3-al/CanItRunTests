                "exec": [
                  "pm.test('Server returns 503', function () { pm.response.to.have.status(503); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{httpbinUrl}}/status/503"
          }
        }
      ]
