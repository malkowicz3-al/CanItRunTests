    {
      "name": "httpbin",
      "item": [
        {
          "name": "GET with dynamic variables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const args = pm.response.json().args;",
                  "pm.test('requestId is a GUID', function () {",
                  "    pm.expect(args.requestId).to.match(/^[0-9a-f-]{36}$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Client", "value": "CanItRunTests" }
            ],
            "url": "{{httpbinUrl}}/get?requestId={{$guid}}&ts={{$timestamp}}"
          }
        },
        {
          "name": "Signed request (HS256 JWS)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generates sendDate, then signs the whole body as a compact JWS (HS256) - same idea as a real signed request.",
                  "function b64url(wordArray) {",
                  "    return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "}",
                  "",
                  "const payload = {",
                  "    orderId: 'ORD-' + Math.floor(Math.random() * 100000),",
                  "    amount: 123.45,",
                  "    sendDate: new Date().toISOString()",
                  "};",
                  "const body = JSON.stringify(payload);",
                  "",
                  "const header = { alg: 'HS256', typ: 'JOSE' };",
                  "const signingInput = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header))) + '.' + b64url(CryptoJS.enc.Utf8.parse(body));",
                  "const signature = b64url(CryptoJS.HmacSHA256(signingInput, pm.environment.get('hmacSecret')));",
                  "",
                  "pm.variables.set('signedBody', body);",
                  "pm.variables.set('jwsSignature', signingInput + '.' + signature);",
                  "console.log('Signed body', body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const echo = pm.response.json();",
                  "pm.test('Signature header was sent', function () {",
                  "    pm.expect(echo.headers['X-Jws-Signature']).to.have.length.above(20);",
                  "});",
                  "pm.test('Body contains sendDate', function () {",
                  "    pm.expect(echo.json).to.have.property('sendDate');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-JWS-Signature", "value": "{{jwsSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{signedBody}}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{httpbinUrl}}/anything/payments"
          }
        },
        {
          "name": "Basic auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().authenticated).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "demo", "type": "string" },
                { "key": "password", "value": "demo-pass", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{httpbinUrl}}/basic-auth/demo/demo-pass"
          }
        },
