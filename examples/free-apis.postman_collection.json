    {
      "name": "Restful-Booker (token flow)",
      "item": [
        {
          "name": "Create token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const token = pm.response.json().token;",
                  "pm.test('Token returned', function () { pm.expect(token).to.be.a('string'); });",
                  "pm.environment.set('bookerToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bookerUser}}\",\n  \"password\": \"{{bookerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{bookerUrl}}/auth"
          }
        },
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const checkin = new Date();",
                  "const checkout = new Date(checkin.getTime() + 3 * 24 * 3600 * 1000);",
                  "pm.variables.set('checkin', checkin.toISOString().slice(0, 10));",
                  "pm.variables.set('checkout', checkout.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const id = pm.response.json().bookingid;",
                  "pm.test('Booking id returned', function () { pm.expect(id).to.be.a('number'); });",
                  "pm.environment.set('bookingId', String(id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Jan\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 250,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{bookerUrl}}/booking"
          }
        },
        {
          "name": "Get booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Firstname is Jan', function () {",
                  "    pm.expect(pm.response.json().firstname).to.eql('Jan');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{bookerUrl}}/booking/{{bookingId}}"
          }
        },
        {
          "name": "Update booking (needs token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Price updated', function () {",
                  "    pm.expect(pm.response.json().totalprice).to.eql(999);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Cookie", "value": "token={{bookerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalprice\": 999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{bookerUrl}}/booking/{{bookingId}}"
          }
        },
        {
          "name": "Delete booking (needs token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 (Restful-Booker quirk)', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Cookie", "value": "token={{bookerToken}}" }
            ],
            "url": "{{bookerUrl}}/booking/{{bookingId}}"
          }
        }
      ]
    },
